APP_NAME=Document Intelligence Platform
DEBUG=False

# PostgreSQL (docker compose up -d db). For a quick try without Docker:
# DATABASE_URL=sqlite:///./data/dip.db
DATABASE_URL=postgresql+psycopg://dip:dip@localhost:5432/dip

# Any OpenAI-compatible endpoint. Free option: Groq (open-source Llama / Qwen models).
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_key_here
LLM_MODEL=llama-3.1-8b-instant
# Local alternative with Ollama: LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:7b
# Offline demo with no key: LLM_PROVIDER=mock

# fastembed (pip install ".[embeddings]") or hashing (no download, weaker)
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
