# ===========================
# Application
# ===========================
APP_NAME=Document Intelligence Platform
APP_VERSION=1.0.0
DEBUG=True

# ===========================
# SQLite
# ===========================
DATABASE_URL=sqlite:///./data/document_intelligence.db

# ===========================
# MongoDB
# ===========================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=document_intelligence

# ===========================
# LLM
# ===========================
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1

# ===========================
# Logging
# ===========================
LOG_LEVEL=INFO