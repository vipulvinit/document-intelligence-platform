APP_NAME=Medical Helpline
DEBUG=False

# SQLite: no installation needed. The file is created on first start.
DATABASE_URL=sqlite:///./data/helpline.db
# PostgreSQL alternative (pip install ".[postgres]"):
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/helpline

# Figure images and uploaded files are stored in this folder.
STORAGE_BACKEND=local
STORAGE_DIR=./data/objects

# ── Language model ────────────────────────────────────────────────────────────
# Any OpenAI-compatible API works: set these three lines. Pick ONE preset below.
# Model names change over time: check the provider's model list if one is "not found".
# Offline demo with no key at all: LLM_PROVIDER=mock
LLM_PROVIDER=openai_compatible

# Preset A - Groq (free tier, very fast). Key: https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_key_here
LLM_MODEL=llama-3.3-70b-versatile
# VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Preset B - Google Gemini (free tier, also reads images). Key: https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your_gemini_key_here
# LLM_MODEL=gemini-2.5-flash
# VISION_MODEL=gemini-2.5-flash

# Preset C - OpenRouter (free models end in ":free"). Key: https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your_openrouter_key_here
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Preset D - Ollama on this computer (no key, no internet): https://ollama.com/download
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:3b
# VISION_MODEL=qwen2.5vl:3b

# Figure descriptions (optional). Leave VISION_MODEL empty to use captions only.
# The vision model may be on another provider, e.g. answers on Groq, figures on Gemini:
# VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# VISION_API_KEY=your_gemini_key_here
VISION_MODEL=
VISION_MAX_FIGURES_PER_ARTICLE=8

# Free tiers rate-limit: retries with growing waits (honours Retry-After)
LLM_MAX_RETRIES=5
LLM_TIMEOUT_SECONDS=120

# ── Embeddings ────────────────────────────────────────────────────────────────
# Run locally on the CPU (free): pip install ".[embeddings]". Use "hashing" for no download.
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Literature ingestion (Europe PMC, free, no key) ───────────────────────────
MAX_ARTICLES_PER_POLL=20
INITIAL_LOOKBACK_DAYS=30
DOWNLOAD_FIGURES=True
SEED_DEFAULT_SOURCES=True
